# Required by Docker Compose. Generate a unique password; no production default exists.
POSTGRES_USER=archverse
POSTGRES_PASSWORD=
POSTGRES_DB=archverse
DATABASE_URL=

# Exact public origins with no trailing slash.
APP_URL=http://localhost:3050
WEB_URL=http://localhost:4173
CORS_ORIGIN=http://localhost:4173

# GitHub OAuth app; callback: ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

ARCHVERSE_ENABLE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
VITE_API_URL=http://localhost:3050
VITE_TLDRAW_LICENSE_KEY=
