FROM oven/bun:1.2.22-alpine AS bun-base

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=bun-base /usr/local/bin/bun /usr/local/bin/bun
RUN corepack enable && corepack prepare pnpm@9.12.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/architecture-model/package.json packages/architecture-model/package.json
RUN pnpm install --frozen-lockfile

COPY apps/server apps/server
COPY packages/architecture-model packages/architecture-model
RUN pnpm --filter @archverse/architecture-model build && pnpm --filter @archverse/server build

FROM bun-base
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=build /app/apps/server/dist/index.js ./index.js
COPY --from=build /app/apps/server/dist/migrate.js ./migrate.js
COPY apps/server/migrations ./migrations
USER bun
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD bun -e "const r=await fetch('http://127.0.0.1:3000/ready');if(!r.ok)process.exit(1)"
CMD ["bun", "index.js"]
